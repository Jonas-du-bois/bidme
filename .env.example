# ═══════════════════════════════════════════════════════════════
#  BID — Live Auction System
#  Environment Variables
# ═══════════════════════════════════════════════════════════════
#
#  1. Copy this file:  cp .env.example .env.local
#  2. Fill in the values below
#  3. Restart the dev server:  npm run dev
#
# ═══════════════════════════════════════════════════════════════

# ── Appwrite ──────────────────────────────────────────────────
#
# Create a project at https://cloud.appwrite.io
# Then go to: Project Settings → API Credentials
#
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# Database & Collection IDs — match Phase 1 architecture
# Only change these if you used custom IDs in the Appwrite Console
NEXT_PUBLIC_APPWRITE_DATABASE_ID=bid_db
NEXT_PUBLIC_APPWRITE_COLLECTION_ITEMS_ID=items
NEXT_PUBLIC_APPWRITE_COLLECTION_BIDS_ID=bids

# ── Cloudinary ────────────────────────────────────────────────
#
# Sign up at https://cloudinary.com
# Cloud Name is on the Dashboard homepage
# Create an Unsigned Upload Preset at:
#   Settings → Upload → Upload presets → Add upload preset
#   Name: bid_unsigned | Signing Mode: Unsigned | Folder: bid/items
#
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=bid_unsigned
